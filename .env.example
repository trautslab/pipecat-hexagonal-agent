# ==============================================================================
# SELECCIÓN DE PROVEEDORES (Arquitectura Hexagonal)
# ==============================================================================
# Opciones STT: whisper_local, deepgram, mock
STT_PROVIDER=whisper_local

# Opciones LLM: ollama, openai, mock
LLM_PROVIDER=ollama

# Opciones TTS: piper_local, cartesia, mock
TTS_PROVIDER=piper_local

# Opciones Transporte: local_audio, daily_webrtc
TRANSPORT_PROVIDER=local_audio

# ==============================================================================
# CONFIGURACIÓN DEL AGENTE
# ==============================================================================
AGENT_NAME="Aura"
AGENT_LANGUAGE="es"
AGENT_SYSTEM_PROMPT="Eres un asistente de voz en español, cordial, preciso y conversacional. Responde en frases cortas y naturales optimizadas para ser habladas."

# ==============================================================================
# CONFIGURACIÓN LOCAL GRATUITA (Zero-Cost)
# ==============================================================================
# STT Whisper Local (models: tiny, base, small, medium)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto

# LLM Ollama Local
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# TTS Piper Local
PIPER_VOICE_NAME=es_ES-davefx-medium
PIPER_MODEL_PATH=

# ==============================================================================
# CONFIGURACIÓN CLOUD (Opcional - solo si se activa el proveedor)
# ==============================================================================
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Deepgram
DEEPGRAM_API_KEY=

# Cartesia
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=79a125e8-cd45-4c13-8a67-188112f4dd22

# Daily WebRTC
DAILY_ROOM_URL=
DAILY_TOKEN=
